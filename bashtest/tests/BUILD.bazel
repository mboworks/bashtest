load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//bashtest:bashtest.bzl", "bashtest")
load(":tool_fixture.bzl", "configuration_data", "tool_source")

package(default_visibility = ["//visibility:private"])

bashtest(
    name = "bashtest_test",
    srcs = ["bashtest_test.sh"],
)

bashtest(
    name = "bashtest_init_test",
    srcs = ["bashtest_init_test.sh"],
)

bashtest(
    name = "bashtest_done_test",
    srcs = ["bashtest_done_test.sh"],
)

bashtest(
    name = "bashtest_skip_test",
    srcs = ["bashtest_skip_test.sh"],
)

bashtest(
    name = "bashtest_no_skip_test",
    srcs = ["bashtest_no_skip_test.sh"],
    args = ["--no-skip"],
)

bashtest(
    name = "launcher_test",
    srcs = ["launcher_test.sh"],
    data = ["//bashtest:launcher.sh"],
    env = {"LAUNCHER_RUNFILE": "$(rlocationpath //bashtest:launcher.sh)"},
)

bashtest(
    name = "files_test",
    srcs = ["files_test.sh"],
)

configuration_data(name = "tool_data")

configuration_data(name = "target_data")

tool_source(
    name = "helper_source",
    data = ":tool_data",
)

sh_binary(
    name = "helper",
    srcs = [":helper_source"],
)

configuration_data(
    name = "second_tool_data",
    platform_marker = "second-tool",
)

tool_source(
    name = "second_helper_source",
    data = ":second_tool_data",
)

sh_binary(
    name = "second_helper",
    srcs = [":second_helper_source"],
)

bashtest(
    name = "tools_test",
    srcs = ["tools_test.sh"],
    data = [":target_data"],
    env = {"TARGET_DATA": "$(rlocationpath :target_data)"},
    tools = {
        "HELPER": ":helper",
        "HELPER_ALIAS": ":helper",
        "SECOND_HELPER": ":second_helper",
    },
)

bashtest(
    name = "runtime_test",
    srcs = ["runtime_test.sh"],
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)
